# Template de Configuração - Mesa de Operações B3
# NUNCA insira chaves reais neste arquivo de exemplo.

# Chave do Google AI Studio para o Gemini
GOOGLE_API_KEY=SUA_CHAVE_GOOGLE_GEMINI_AQUI

# Token de acesso da API BRAPI
BRAPI_TOKEN=SEU_TOKEN_BRAPI_AQUI

# Modelo padrão do CrewAI (recomendado: gemini/gemini-flash-lite-latest)
MODEL=gemini/gemini-flash-lite-latest

# Taxa Selic anual de referência para o modelo Black-Scholes (ex: 0.1075 para 10.75% a.a.)
TAXA_SELIC_ANUAL=0.1075

# Desativa telemetria para reduzir latência
OTEL_SDK_DISABLED=true
