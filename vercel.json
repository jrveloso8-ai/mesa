{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/midia/(.*)",
      "dest": "/static/midia/$1"
    },
    {
      "src": "/apresentacao",
      "dest": "/static/apresentacao.html"
    },
    {
      "src": "/apresentacao.html",
      "dest": "/static/apresentacao.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/(.*)",
      "dest": "server.py"
    }
  ]
}
